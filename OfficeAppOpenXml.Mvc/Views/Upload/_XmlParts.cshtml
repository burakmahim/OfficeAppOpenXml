@model IDictionary<string, string>
@{
    var fileName = ViewBag.FileName as string;
}
<h5 class="mb-3">@fileName için XML Parçaları</h5>
<div class="panel-group" id="acc">
    @foreach (var p in Model)
    {
        var id = "p_" + p.Key.Replace("/", "_").Replace(".", "_").Replace("\\", "_");
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title"><a data-toggle="collapse" href="#@id">@p.Key</a></h4>
            </div>
            <div id="@id" class="panel-collapse collapse">
                <div class="panel-body"><textarea class="xml-view">@p.Value</textarea></div>
            </div>
        </div>
    }
</div>
