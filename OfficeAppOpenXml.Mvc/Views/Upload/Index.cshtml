@{
    ViewBag.Title = "OpenXML XML Çıkar";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/eclipse.min.css" />
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>

<form id="mainForm" enctype="multipart/form-data">
    <input class="form-control mb-2" type="file" name="file" accept=".docx,.xlsx,.pptx,.zip" />
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="includeRels" id="rels" checked />
        <label class="form-check-label" for="rels">.rels dosyalarını da dahil et</label>
    </div>
    <div class="d-flex gap-2">
        <button id="btnXml" class="btn btn-primary">XML’leri Göster</button>
        <button id="btnDsl" class="btn btn-success">DSL’e Çevir ve Göster</button>
        <button id="btnZip" class="btn btn-outline-secondary">XML’leri ZIP indir</button>
    </div>
</form>

<hr />
<div id="result"></div>

<script>
function initEditors(){
  document.querySelectorAll('textarea.xml-view, textarea.xml-dsl').forEach(function(ta){
    var ed = CodeMirror.fromTextArea(ta, {mode:"application/xml", lineNumbers:true, theme:"eclipse", lineWrapping:true, readOnly:true});
    ed.setSize("100%","400px");
  });
}
function postPartial(url){
  var fd = new FormData(document.getElementById('mainForm'));
  $.ajax({ url:url, method:'POST', data:fd, processData:false, contentType:false })
   .done(function(html){ $('#result').html(html); initEditors(); })
   .fail(function(xhr){ alert('Hata: ' + (xhr.responseText || xhr.status)); });
}
$('#btnXml').on('click', function(e){ e.preventDefault(); postPartial('@Url.Action("ExtractPartial","Upload")'); });
$('#btnDsl').on('click', function(e){ e.preventDefault(); postPartial('@Url.Action("ConvertToDslPartial","Upload")'); });
$('#btnZip').on('click', function(e){
  e.preventDefault();
  var fd = new FormData(document.getElementById('mainForm'));
  fetch('@Url.Action("DownloadZip","Upload")', { method:'POST', body: fd })
    .then(r=>r.blob()).then(b=>{ var a=document.createElement('a'); a.href=URL.createObjectURL(b); a.download='xml_parts.zip'; a.click(); URL.revokeObjectURL(a.href); });
});
</script>
