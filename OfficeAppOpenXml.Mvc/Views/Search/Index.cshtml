@model List<OfficeAppOpenXmlLibrary.Models.SearchResult>

<form method="get">
    <input type="text" name="q" placeholder="Kelime yazın..." value="@Request["q"]" />
    <button type="submit">Ara</button>
</form>

@if (Model != null)
{
    <h3>Sonuçlar:</h3>
    <ul>
        @foreach (var item in Model)
        {
            <li>@item.FileName (@item.FileType) - @item.Created</li>
        }
    </ul>
}
