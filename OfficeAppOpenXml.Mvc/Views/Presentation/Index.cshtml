@{
    ViewBag.Title = "Office Oluştur";
    string xml = ViewBag.XmlContent as string ?? "";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/eclipse.min.css">

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>

<div class="container-fluid mt-5">
    <h1 class="mb-4">.NET Framework 48</h1>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form id="mainForm" method="post">
        <textarea id="xmlContent" name="xmlContent" hidden>@xml</textarea>

        <textarea id="xmlEditor" rows="30">@xml</textarea>

		<div class="mt-4">

			<input type="hidden" id="fileType" name="fileType" value="" />

			<button type="button" class="btn btn-primary me-2" onclick="uploadToDB('PowerPoint')">PowerPoint DB'ye Kaydet</button>

			<button type="button" class="btn btn-success me-2" onclick="uploadToDB('Excel')">Excel DB'ye Kaydet</button>

			<button type="submit" class="btn btn-success me-2"
					formaction="/Presentation/GenerateExcelFromXml"
					onclick="document.getElementById('xmlContent').value = editor.getValue();">
				Excel İndir
			</button>

			<button type="submit" class="btn btn-success me-2"
					formaction="/Presentation/DownloadPptx"
					onclick="document.getElementById('xmlContent').value = editor.getValue();">
				PowerPoint İndir
			</button>


		</div>
    </form>

    <div class="d-none mt-4" id="pdfContainer">
        <h4>📄 PDF Önizleme:</h4>
        <iframe name="pdfFrame" width="100%" height="600px" style="border: 1px solid #ccc;"></iframe>
    </div>

</div>


<script>
    const editor = CodeMirror.fromTextArea(document.getElementById("xmlEditor"), {
        mode: "application/xml",
        lineNumbers: true,
        theme: "eclipse",
        lineWrapping: true,
        indentUnit: 4,
        tabSize: 4
    });

    editor.setSize("100%", "700px");

    function uploadToDB(type) {
        document.getElementById("xmlContent").value = editor.getValue();
        document.getElementById("fileType").value = type;

        var form = document.getElementById("mainForm");
        form.action = "/Presentation/UploadToDB";
        form.submit();
    }
</script>
