				<cell>60</cell>
			</row>
		</table>

		<!-- TABLO-3 (A16): Scatter/Bubble için ortak X ve iki seri Y (+ bubble size) -->
		<table startCell="A16">
			<row>
				<cell>X</cell>
				<cell>Y_A</cell>
