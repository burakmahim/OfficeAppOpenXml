<excel>
	<sheet name="SampleChart">
		<chart type="column" title="Shadow Glow Example">

			<category-axis>
				<format>
					<line visible="true" width="3pt" dash="solid" compound="single" cap="round" join="miter"
						  begin-arrow-type="triangle" end-arrow-type="arrow" join-miter-limit="10">
						<solid color="#0000FF" transparency="0"/>
					</line>

					<effects>
						<shadow type="outer" color="#FF0000" transparency="20" blur-radius="5pt" angle="45" distance="4pt"/>
						<glow color="#00FF00" transparency="30" size="10pt"/>
					</effects>

				</format>
			</category-axis>

			<series name="Series 1">
				<point category="A" value="10"/>
				<point category="B" value="20"/>
				<point category="C" value="30"/>
			</series>

		</chart>
	</sheet>
</excel>