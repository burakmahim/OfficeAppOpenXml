<excel>
	<sheet name="ColumnChart">
		<chart type="Column" title="Column Chart with Gradient Fill">
			<plot-area>
				<format>
					<fill>
						<gradient angle="45" scaled="true">
							<stop position="0"   color="#1e90ff" transparency="0"/>
							<stop position="0.1" color="#87cefa" transparency="0"/>
						</gradient>
					</fill>
				</format>
			</plot-area>
			<series>
				<point category="Jan" value="10"/>
				<point category="Feb" value="15"/>
				<point category="Mar" value="8"/>
			</series>
		</chart>
	</sheet>

	<sheet name="BarChart">
		<chart type="Bar" title="Bar Chart with Gradient Fill">
			<plot-area>
				<format>
					<fill>
						<gradient angle="90" scaled="false">
							<stop position="0"   color="#ff8c00" transparency="0"/>
							<stop position="0.1" color="#32cd32" transparency="0"/>
						</gradient>
					</fill>
				</format>
			</plot-area>
			<series>
				<point category="Q1" value="20"/>
				<point category="Q2" value="25"/>
				<point category="Q3" value="18"/>
			</series>
		</chart>
	</sheet>

	<sheet name="LineChart">
		<chart type="LineMarkers" title="Line Chart with Gradient Fill">
			<plot-area>
				<format>
					<fill>
						<gradient angle="0" scaled="true">
							<stop position="0"   color="#6a5acd" transparency="0"/>
							<stop position="0.1" color="#b19cd9" transparency="0"/>
						</gradient>
					</fill>
				</format>
			</plot-area>

			<category-axis/>
			<value-axis/>

			<series name="Yıllık">
				<format>
					<line visible="true" dash="Solid" compound="Single" width="2" color="#000000"/>
					<marker show="true" size="6"/>
				</format>

				<point category="2019" value="5"/>
				<point category="2020" value="7"/>
				<point category="2021" value="6"/>
			</series>
		</chart>
	</sheet>




</excel>
