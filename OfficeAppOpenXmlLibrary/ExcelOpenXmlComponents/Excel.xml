		<!-- 1) COLUMN: Tablodan referans -->
		<chart
		  type="column"
		  title="Sütun (Column)"
		  categories="&apos;Charts&apos;!$A$2:$A$6"
		  values="&apos;Charts&apos;!$B$2:$B$6; &apos;Charts&apos;!$C$2:$C$6"
		  series="Ürün A;Ürün B"
		  from="E2"
		  to="N17" />

		<!-- 2) BAR: Tablodan referans -->
		<chart
		  type="bar"
		  title="Çubuk (Bar)"
		  categories="&apos;Charts&apos;!$A$2:$A$6"
		  values="&apos;Charts&apos;!$B$2:$B$6; &apos;Charts&apos;!$C$2:$C$6"
		  series="Ürün A;Ürün B"
		  from="E19"
		  to="N34" />

		<!-- 3) LINE: Tablodan referans -->
		<chart
		  type="line"
		  title="Çizgi (Line)"
		  categories="&apos;Charts&apos;!$A$2:$A$6"
		  values="&apos;Charts&apos;!$B$2:$B$6; &apos;Charts&apos;!$C$2:$C$6"
		  series="Ürün A;Ürün B"
		  from="O2"
		  to="V17" />

		<!-- 4) AREA: INLINE veri (kendi içinde points) -->
		<chart type="area" title="Alan (Area) - Inline" from="O19" to="V34">
			<series name="2023">
				<point category="Ocak"  value="12"/>
				<point category="Şubat" value="15"/>
				<point category="Mart"  value="9"/>
				<point category="Nisan" value="20"/>
				<point category="Mayıs" value="17"/>
			</series>
			<series name="2024">
				<point category="Ocak"  value="14"/>
				<point category="Şubat" value="16"/>
				<point category="Mart"  value="10"/>
				<point category="Nisan" value="19"/>
				<point category="Mayıs" value="21"/>
			</series>
		</chart>

		<!-- 5) PIE: Tablodan referans (tek seri) -->
		<chart
		  type="pie"
		  title="Pasta (Pie)"
		  categories="&apos;Charts&apos;!$A$2:$A$6"
		  values="&apos;Charts&apos;!$B$2:$B$6"
		  series="Ürün A"
		  from="W2"
		  to="AD17" />

		<!-- 6) DOUGHNUT: INLINE veri (tek seri) -->
		<chart type="doughnut" title="Halka (Doughnut)" from="W19" to="AD34">
			<series name="Ürün B">
				<point category="Ocak"  value="8"/>
				<point category="Şubat" value="11"/>
				<point category="Mart"  value="14"/>
				<point category="Nisan" value="16"/>
				<point category="Mayıs" value="18"/>
			</series>
		</chart>

		<!-- 7) SCATTER: Tablodan referans (tek X - iki Y) -->
		<chart
		  type="scatter"
		  title="Dağılım (Scatter)"
		  categories="&apos;Charts&apos;!$A$17:$A$21"
		  values="&apos;Charts&apos;!$B$17:$B$21; &apos;Charts&apos;!$D$17:$D$21"
		  series="Seri A;Seri B"
		  from="AE2"
		  to="AL17" />

		<!-- 8) BUBBLE: Tablodan referans (tek X - iki Y, (opsiyonel) size) -->
		<chart
		  type="bubble"
		  title="Kabarcık (Bubble)"
		  categories="&apos;Charts&apos;!$A$17:$A$21"
		  values="&apos;Charts&apos;!$B$17:$B$21; &apos;Charts&apos;!$D$17:$D$21"
		  series="Seri A;Seri B"
		  sizes="&apos;Charts&apos;!$C$17:$C$21; &apos;Charts&apos;!$E$17:$E$21"
		  from="AE19"
		  to="AL34" />

		<!-- 9) RADAR: Tablodan referans -->
		<chart
		  type="radar"
		  title="Radar"
		  categories="&apos;Charts&apos;!$A$9:$A$13"
		  values="&apos;Charts&apos;!$B$9:$B$13; &apos;Charts&apos;!$C$9:$C$13"
		  series="Seri A;Seri B"
		  from="AM2"
		  to="AT17" />

	</sheet>
</excel>
