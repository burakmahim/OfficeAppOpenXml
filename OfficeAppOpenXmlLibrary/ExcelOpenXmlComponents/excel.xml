	<!-- 4. 3D Bar Chart -->
	<sheet name="Departman Bütçesi">
		<chart type="bar" width="450px" height="300px" title="Departman Bütçesi"
               grouping-type="clustered" gap-width="100">
			<category-axis title="Departmanlar" />
			<value-axis title="Bütçe (TL)" />
			<legend show="true" position="top" />
			<view-3d shape="box" rotation-x="15" rotation-y="20" depth-percent="150"
                     right-angle-axes="true" />
			<series title="2023 Bütçe" color="#5B9BD5">
				<point category="IT" value="500000" />
				<point category="HR" value="200000" />
				<point category="Pazarlama" value="350000" />
				<point category="Satış" value="450000" />
			</series>
			<series title="2024 Hedef" color="#A5A5A5">
				<point category="IT" value="600000" />
				<point category="HR" value="250000" />
				<point category="Pazarlama" value="400000" />
				<point category="Satış" value="500000" />
			</series>
		</chart>
	</sheet>
	<!-- 6. Stacked Area Chart -->
	<sheet name="Kaynak Kullanımı">
		<chart type="area" width="500px" height="300px" title="Kaynak Kullanımı"
               grouping-type="stacked">
			<category-axis title="Zaman" />
			<value-axis title="Kullanım %" min="0" max="100" />
			<legend show="true" position="top" />
			<series title="CPU" color="#FF9999" color-transparency="30">
				<point category="09:00" value="25" />
				<point category="10:00" value="35" />
				<point category="11:00" value="45" />
				<point category="12:00" value="30" />
				<point category="13:00" value="20" />
			</series>
			<series title="Memory" color="#99FF99" color-transparency="30">
				<point category="09:00" value="40" />
				<point category="10:00" value="50" />
				<point category="11:00" value="35" />
				<point category="12:00" value="45" />
				<point category="13:00" value="55" />
			</series>
			<series title="Disk" color="#9999FF" color-transparency="30">
				<point category="09:00" value="15" />
				<point category="10:00" value="10" />
				<point category="11:00" value="20" />
				<point category="12:00" value="25" />
				<point category="13:00" value="25" />
			</series>
		</chart>
	</sheet>
	<sheet name="Tüm Özellikler">
		<chart type="column" width="600px" height="450px" title="Tüm Özellikler Kombinasyonu"
			   vary-colors="false" auto-title="false" rounded-corners="true"
			   overlap="20" gap-width="120">

			<category-axis title="Kategoriler" min="0" max="5">
				<text-format>
					<font family="Segoe UI" size="11" bold="true" color="2F4F4F" />
					<rotate>30</rotate>
				</text-format>
				<format>
					<fill>

					</fill>
					<line visible="true" width="2pt" dash="solid">
						<solid color="4682B4" />
					</line>
					<effects>
						<shadow type="outer" color="808080" transparency="50"
								blur-radius="4pt" distance="2pt" angle="45" />
					</effects>
				</format>
			</category-axis>

			<value-axis title="Değerler" min="0" max="150" major-unit="30">
				<text-format>
					<font family="Segoe UI" size="10" italic="true" color="8B4513" />
				</text-format>
				<format>
					<line visible="true" width="1pt">
						<solid color="A0A0A0" />
					</line>
				</format>
			</value-axis>

			<legend show="true" position="top">
				<format>
					<fill>
						<solid color="FFFAF0" transparency="20" />
					</fill>
					<line visible="true">
						<solid color="CD853F" />
					</line>
				</format>
				<text-format>
					<font family="Calibri" size="10" bold="true" color="8B4513" />
				</text-format>
			</legend>

			<grid show-horizontal="true" show-vertical="false">
				<horizontal-format>
					<line visible="true" width="1pt" dash="dot">
						<solid color="D3D3D3" />
					</line>
				</horizontal-format>
			</grid>

			<value-labels show="true" position="outsideend" show-series-name="false">
				<text-format>
					<font family="Arial" size="9" bold="true" color="FFFFFF" />
				</text-format>
			</value-labels>

			<plot-area-format>
				<line visible="true" width="2pt">
					<solid color="4682B4" />
				</line>
				<effects>
					<shadow type="inner" color="696969" transparency="60"
							blur-radius="8pt" distance="4pt" />
					<soft-edges size="6pt" />
				</effects>
			</plot-area-format>

			<text-format>
				<font family="Segoe UI" size="14" bold="true" color="2C3E50" />
			</text-format>

			<data-table show="true" show-horizontal-border="true"
						show-vertical-border="true" show-outline="true" show-keys="true">
				<text-format>
					<font family="Consolas" size="9" color="666666" />
				</text-format>
			</data-table>

			<series title="Birinci Seri" color="E74C3C">
				<format>
					<line visible="true" width="2pt">
						<solid color="922B21" />
					</line>
					<effects>
						<shadow type="outer" color="000000" transparency="40"
								blur-radius="5pt" distance="3pt" angle="45" />
						<glow color="FFD700" size="4pt" transparency="50" />
					</effects>
				</format>
				<point category="A" value="85">
					<format>
						<fill>
							<solid color="FF1493" />
						</fill>
					</format>
					<value-labels show="true" position="outsideend">
						<text-format>
							<font color="FF1493" bold="true" />
						</text-format>
					</value-labels>
				</point>
				<point category="B" value="95" />
				<point category="C" value="75" />
				<point category="D" value="110" />
			</series>

			<series title="İkinci Seri" color="3498DB">
				<format>
					<fill>
						<pattern preset="smallgrid"
								 foreground-color="3498DB"
								 background-color="AED6F1" />
					</fill>
					<line visible="true" width="1pt" dash="dash">
						<solid color="2874A6" />
					</line>
				</format>
				<point category="A" value="70" />
				<point category="B" value="88" />
				<point category="C" value="92" />
				<point category="D" value="78" />
			</series>
		</chart>
	</sheet>
	<sheet name="Satış Verileri">
		<chart type="column" width="600px" height="400px" title="Satış Verileri">
			<!-- Chart Title -->
			<title text="Satış Verileri">
				<text-format align-horizontal="center" align-vertical="center" wrap="none"
                             margin-left="2pt" margin-right="2pt" margin-top="1pt" margin-bottom="1pt"
                             rotate="0">
					<fill>
						<solid color="#FFFFFF"/>
					</fill>
					<line width="1pt" color="#2C3E50"/>
					<effects>
						<shadow type="outer" color="#808080" blur-radius="3pt" angle="45" distance="2pt"/>
						<glow color="#FFAA00" size="5pt" transparency="30"/>
						<reflection blur-radius="4pt" distance="3pt" start-transparency="10" end-transparency="70"/>
					</effects>
					<font family="Segoe UI" size="16pt" bold="true" italic="true" color="#2C3E50" underline="single" strike="none" caps="none"/>
				</text-format>
			</title>

			<!-- Category Axis -->
			<category-axis title="Aylar">
				<title text="Aylar">
					<text-format align-horizontal="center" align-vertical="center" wrap="none"
                                 margin-left="2pt" margin-right="2pt" margin-top="1pt" margin-bottom="1pt"
                                 rotate="270">
						<fill>
							<solid color="#E6F2FF"/>
						</fill>
						<line width="1pt" color="#2C3E50"/>
						<effects>
							<shadow type="outer" color="#888888" blur-radius="3pt" distance="2pt" angle="45"/>
							<glow color="#FFAA00" size="5pt" transparency="20"/>
						</effects>
						<font family="Segoe UI" size="12pt" bold="true" italic="false" color="#2C3E50"/>
					</text-format>
				</title>
				<format>
					<fill>
						<solid color="#D9EDF7"/>
					</fill>
					<line visible="true" width="1pt" dash="solid">
						<solid color="#2C3E50"/>
					</line>
					<effects>
						<shadow type="outer" color="#808080" blur-radius="2pt" distance="1pt" angle="45"/>
					</effects>
				</format>
			</category-axis>

			<!-- Value Axis -->
			<value-axis title="Miktar">
				<title text="Miktar">
					<text-format align-horizontal="center" align-vertical="center" wrap="none"
                                 margin-left="2pt" margin-right="2pt" margin-top="1pt" margin-bottom="1pt"
                                 rotate="270">
						<fill>
							<solid color="#FFF5E6"/>
						</fill>
						<line width="1pt" color="#2C3E50"/>
						<effects>
							<shadow type="outer" color="#888888" blur-radius="3pt" distance="2pt" angle="45"/>
							<glow color="#FFAA00" size="5pt" transparency="20"/>
						</effects>
						<font family="Segoe UI" size="12pt" bold="true" italic="true" color="#2C3E50"/>
					</text-format>
				</title>
				<format>
					<line visible="true" width="1pt" dash="solid">
						<solid color="#D3D3D3"/>
					</line>
				</format>
			</value-axis>

			<!-- Legend -->
			<legend show="true" position="top">
				<text-format>
					<font family="Calibri" size="10pt" bold="true" color="#2C3E50"/>
				</text-format>
			</legend>

			<!-- Data Table -->
			<data-table show="true" show-horizontal-border="true" show-vertical-border="true" show-outline="true" show-keys="true">
				<text-format>
					<font family="Consolas" size="9pt" color="#666666"/>
				</text-format>
			</data-table>

			<!-- Series 1 -->
			<series name="2023 Satışları" color="#4472C4">
				<point category="Ocak" value="150"/>
				<point category="Şubat" value="200"/>
				<point category="Mart" value="175"/>
				<point category="Nisan" value="300"/>
				<point category="Mayıs" value="250"/>
			</series>

			<!-- Series 2 -->
			<series name="2024 Satışları" color="#E7A03A">
				<point category="Ocak" value="180"/>
				<point category="Şubat" value="220"/>
				<point category="Mart" value="195"/>
				<point category="Nisan" value="350"/>
				<point category="Mayıs" value="280"/>
			</series>

		</chart>
