@using OfficeAppOpenXmlLibrary

@{
	ViewData["Title"] = "Search";
}

<div class="container mt-4">
	<div class="row">
		<div class="col-md-12">
			<h2>Search</h2>
		</div>
	</div>

	<div class="row mt-4">
		<div class="col-md-12">
			<form method="post" asp-controller="Search" asp-action="Index" class="d-flex" id="searchForm">
				<input type="search" id="searchInput" name="Query"
					   class="form-control rounded me-2"
					   placeholder="Enter keyword to search"
					   value="@ViewBag.Query" />
				<button type="submit" class="btn btn-primary">Search</button>
			</form>
		</div>
	</div>

	@if (ViewBag.Error != null)
	{
		<div class="row mt-4">
			<div class="col-md-12">
				<div class="alert alert-danger">
					@ViewBag.Error
				</div>
			</div>
		</div>
	}

	@if (ViewBag.DebugInfo != null)
	{
		<div class="row mt-4">
			<div class="col-md-12">
				<div class="alert alert-info">
					<h5>Debug Info:</h5>
					<ul>
						@foreach (string info in (List<string>)ViewBag.DebugInfo)
						{
							<li>@info</li>
						}
					</ul>
				</div>
			</div>
		</div>
	}

	@if (ViewBag.Results != null && ((List<SearchResult>)ViewBag.Results).Count > 0)
	{
		List<SearchResult> results = (List<SearchResult>)ViewBag.Results;
		<div class="row mt-4">
			<div class="col-md-12">
				<h4>Results (@results.Count):</h4>
				<table class="table table-striped">
					<thead>
						<tr>
							<th>File Name</th>
							<th>Item Type</th>
							<th>Summary</th>
							<th>Full Path</th>
						</tr>
					</thead>
					<tbody>
						@foreach (SearchResult result in results)
						{
							<tr>
								<td>@result.FileName</td>
								<td><small>@result.ItemType</small></td>
								<td style="max-width: 300px;">
									<small>
										@if (!string.IsNullOrEmpty(result.AutoSummary) && result.AutoSummary.Length > 150)
										{
											<span title="@result.AutoSummary">@(result.AutoSummary.Substring(0, 150))...</span>
										}
										else
										{
											@result.AutoSummary
										}
									</small>
								</td>
								<td><small>@result.FilePath</small></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
	else if (!string.IsNullOrWhiteSpace((string)ViewBag.Query))
	{
		<div class="row mt-4">
			<div class="col-md-12">
				<p>No results found for "<strong>@ViewBag.Query</strong>".</p>
			</div>
		</div>
	}
</div>
