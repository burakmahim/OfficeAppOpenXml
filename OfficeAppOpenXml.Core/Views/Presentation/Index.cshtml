@{
    ViewData["Title"] = "Sunum ve Excel Oluştur (.NET 9)";
    string xml = ViewBag.XmlContent as string ?? "";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/eclipse.min.css">

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>

<div class="container-fluid mt-5">
    <h1 class="mb-4">.NET CORE 9</h1>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <!-- Excel Upload Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h3>📊 Excel Dosyası Upload ve XML Görüntüleme</h3>
        </div>
        <div class="card-body">
            <form id="uploadForm" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="excelFile" class="form-label">Excel Dosyası Seçin (.xlsx, .xls):</label>
                    <input type="file" class="form-control" id="excelFile" name="excelFile" accept=".xlsx,.xls" required>
                </div>
                <button type="button" class="btn btn-warning" onclick="uploadAndViewXml()">
                    Upload ve XML Görüntüle
                </button>
            </form>

            <div id="uploadResult" class="mt-3" style="display:none;">
                <div class="alert alert-success">
                    <strong>✅ Başarılı!</strong> Excel dosyası yüklendi ve XML'e dönüştürüldü.
                </div>
            </div>
        </div>
    </div>

    <form id="mainForm" method="post">
        <textarea id="xmlContent" name="xmlContent" hidden>@xml</textarea>
        <textarea id="xmlEditor" rows="30">@xml</textarea>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2" formaction="/Presentation/DownloadPptx">
                PowerPoint Oluştur ve İndir
            </button>

            <button type="submit" class="btn btn-success me-2" formaction="/Presentation/GenerateExcelFromXml">
                Excel Oluştur ve İndir
            </button>

        </div>
    </form>

    <div class="d-none mt-4" id="pdfContainer">
        <h4>📄 PDF Önizleme:</h4>
        <iframe name="pdfFrame" width="100%" height="600px" style="border: 1px solid #ccc;"></iframe>
    </div>
</div>

<script>
    const editor = CodeMirror.fromTextArea(document.getElementById("xmlEditor"), {
        mode: "application/xml",
        lineNumbers: true,
        theme: "eclipse",
        lineWrapping: true,
        indentUnit: 4,
        tabSize: 4
    });

    editor.setSize("100%", "700px");

    document.getElementById("mainForm").addEventListener("submit", function () {
        document.getElementById("xmlContent").value = editor.getValue();
    });

    function uploadAndViewXml() {
        const fileInput = document.getElementById('excelFile');
        const file = fileInput.files[0];

        if (!file) {
            alert('Lütfen bir Excel dosyası seçin');
            return;
        }

        const formData = new FormData();
        formData.append('excelFile', file);

        fetch('/Presentation/UploadExcelAndViewXml', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                editor.setValue(data.xmlContent);
                document.getElementById('uploadResult').style.display = 'block';
            } else {
                alert('Hata: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Upload sırasında hata oluştu');
        });
    }
</script>
